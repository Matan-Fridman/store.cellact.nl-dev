# ─── Frontend (Vite) — GitHub Pages ─────────────────────────────────────────
# Deploy via .github/workflows/deploy-github-pages.yml
# Repo → Settings → Pages → Source: GitHub Actions
# Put the same VITE_* values below into GitHub Actions Secrets.
#
# Custom domain: Settings → Pages → Custom domain (DNS at your registrar).
# Optional CNAME file is created by GitHub when you save the custom domain.
#
# Base path: "/" for a custom domain (default).
# For project URL only (no custom domain): VITE_BASE_PATH=/secnum-nl-store/
# VITE_BASE_PATH=/

# Meta Pixel — required for Facebook purchase optimization
# VITE_META_PIXEL_ID=123456789012345

# Stripe coupon id for FB A/B "offer" variant (30% first month).
# Only set this AFTER payment-link-generator accepts couponId and the coupon exists in Stripe.
# Until then, FB visitors still get campaign copy + welcome banner (no fake discount).
# VITE_STRIPE_FB_COUPON_ID=fb_first_month_30


# Production URLs (used when VITE_USE_PRODUCTION_URLS=true). Omit to reuse dev URLs.
# VITE_PROD_API_URL=https://...
# VITE_PROD_STRIPE_URL=https://...
# VITE_PROD_ORDER_RESULT_URL=https://...
# Poll URL can be the Stripe adapter (proxies to processor) or the processor directly.

# ─── Payment processor (ingest: buckets + Pub/Sub, target `main`) ──────────────
# PROCESSOR_INGEST_SECRET=long-random-shared-with-adapters-only
# GOOGLE_CLOUD_PROJECT=...
# PAYMENT_EVENTS_TOPIC=secnum-payment-events
# Optional: INGEST_KEYS_COLLECTION, PAYMENT_EVENT_BUCKET_ROOT

# ─── Payment handler (single HTTP function `main`: order-result + POST /_pubsub push)
# BLOCKCHAIN_CF_URL=https://...
# STORE_ORIGIN=https://...
# DEDUP_COLLECTION=payment_events_processed
# Optional: SECNUM_PACKAGE_ID, ORDERS_COLLECTION

# ─── Stripe adapter (webhook/) ─────────────────────────────────────────────────
# PROCESSOR_URL=https://...       # POST /v1/events
# HANDLER_URL=https://...         # GET /order-result (preferred)
# PROCESSOR_INGEST_SECRET=...
# stripe_secret / stripe_prod_secret — Stripe webhook signing secrets

# ─── Backend (Google Cloud Run / api/index.js) ───────────────────────────────
# Arnacon wallet private key
COORDINATES=0x...

# Polygon chain ID (137 = mainnet)
CHAIN_ID=137

# ENS namespace
ENS_NAME=secnum

# ─── Stripe webhook (webhook/main.py) ───────────────────────────────────────
# Must match the HTTPS URL of the claim page embedded in arnacon:// links
# STORE_ORIGIN=https://store.secnum.com
