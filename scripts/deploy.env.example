# Copy to deploy.env (gitignored) and fill in. Then:
#   cd /path/to/secnum-store
#   ./scripts/deploy-gcp-payment-stack.sh
#
# Or: DEPLOY_ENV_FILE=/path/to/deploy.env ./scripts/deploy-gcp-payment-stack.sh

# Required
export GCP_PROJECT="arnacon-nl"
export GCP_REGION="europe-west1"

# Storefront URL embedded in claim links (must match your real shop)
export STORE_ORIGIN="https://your-store.vercel.app"

# Processor ingest (same value on processor + Stripe adapter)
export PROCESSOR_INGEST_SECRET=""

# If you already deployed the processor, set this HTTPS URL (no trailing slash) to skip redeploying it:
# export EXISTING_PROCESSOR_URL="https://secnum-payment-processor-xxxxx-ew.a.run.app"
# If the function name is not the default, set FN_PROCESSOR so IAM bindings still match:
# export FN_PROCESSOR="secnum-payment-processor"

# GCS bucket for numbers.json (chain purchase)
export BUCKET_NAME="secnum-numbers"

# Secret Manager secret id holding the hex private key (mounted as COORDINATES)
export COORDINATES_SECRET_ID="key-281"

# Stripe webhook signing secret — two options (Secret Manager preferred for production):
#
# Option A — Secret Manager (set secret IDs; the adapter fetches the value at runtime):
# export STRIPE_SECRET_ID="stripe-webhook-secret-test"
# export STRIPE_PROD_SECRET_ID="stripe-webhook-secret-live"
#
# Option B — plain env var (fine for dev / quick deploys):
export STRIPE_SECRET="whsec_..."
# export STRIPE_PROD_SECRET="whsec_..."

# If your org requires explicit unconditional IAM bindings:
# export DEPLOY_USE_CONDITION_NONE=1

# Redeploy every Cloud Function even if it already exists (default is skip + reuse URL):
# export DEPLOY_FORCE=1

# Where to write discovered URLs (gitignored default: ./deploy.state in repo root):
# export DEPLOY_STATE_FILE=/path/to/deploy.state

# Optional: override Cloud Function names (defaults below)
# export FN_PROCESSOR="secnum-payment-processor"
# export FN_CHAIN_SERVER="secnum-chain-server"
# export FN_CHAIN_ACTIVATE="secnum-chain-activate"
# export FN_ORDER_RESULT="secnum-order-result"
# export FN_PAYMENT_WORKER="secnum-payment-worker"
# export FN_STRIPE_ADAPTER="secnum-stripe-adapter"
# export PUBSUB_PUSH_SA="sa-pubsub-push"
# export NODE_RUNTIME="nodejs22"
# export PYTHON_RUNTIME="python312"
