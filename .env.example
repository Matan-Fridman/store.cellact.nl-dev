# ─── Frontend (Vite) — GitHub Pages ─────────────────────────────────────────
# Deploy via .github/workflows/deploy-github-pages.yml
# Repo → Settings → Pages → Source: GitHub Actions
#
# Custom domain: store.cellact.nl (public/CNAME + DNS CNAME → cellact.github.io)
# VITE_BASE_PATH=/
#
# GCP functions base (REQUIRED for production):
# VITE_BASE_URL=https://europe-west1-arnacon-production-gcp.cloudfunctions.net
# If unset, code defaults to staging.

# Meta Pixel
# VITE_META_PIXEL_ID=

# Firebase (one project per deployment)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
# VITE_RECAPTCHA_SITE_KEY=
# VITE_FIREBASE_APPCHECK_DEBUG=true

# STORE_ORIGIN=https://store.cellact.nl

# Purchase language: the store sends lang=en|he on checkout.
# Backend must accept and persist it (see README "Purchase language").
