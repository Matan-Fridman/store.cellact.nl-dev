# ── Provider setup ────────────────────────────────────────────────────────────

# Polygon RPC endpoint (used as the network for arnacon-sdk)
CHAIN_ID_POLYGON=https://polygon-rpc.com

# Optional: override the RPC URL separately from the chain ID
# POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# Private key of the funded server wallet.
# This wallet must hold POL (for gas transfers) and PALO (for welcome grants).
# Never commit the real key — add .env to .gitignore.
SERVER_PRIVATE_KEY=0xyour_server_wallet_private_key

# Port for the local Express test server (default: 8083)
# PROVIDER_SETUP_PORT=8083
